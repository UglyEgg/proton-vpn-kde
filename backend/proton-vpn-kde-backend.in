#!@Python3_EXECUTABLE@
"""Installed launcher for the Proton VPN KDE backend."""

import sys
from pathlib import Path

install_prefix = Path(__file__).resolve().parents[1]
sys.path.insert(
    0,
    str(
        install_prefix
        / "@PROTON_VPN_KDE_INSTALL_LIBEXECDIR@"
        / "proton-vpn-kde"
    ),
)

from proton_vpn_kde_backend.__main__ import main


if __name__ == "__main__":
    main()
