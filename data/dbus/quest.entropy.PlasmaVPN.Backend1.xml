    </method>
    <method name="ConnectCountry">
      <annotation name="quest.entropy.PlasmaVPN.Authorization" value="protected"/>
      <arg name="country_code" direction="in" type="s"/>
    </method>
    <method name="ConnectCountryWithFeatures">
      <annotation name="quest.entropy.PlasmaVPN.Authorization" value="protected"/>
      <arg name="country_code" direction="in" type="s"/>
