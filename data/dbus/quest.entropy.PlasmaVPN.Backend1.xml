    </method>
    <method name="GetCustomDns">
      <annotation name="quest.entropy.PlasmaVPN.Authorization" value="read-only"/>
      <arg name="settings_json" direction="out" type="s"/>
    </method>
    <method name="GetGroupServers">
      <annotation name="quest.entropy.PlasmaVPN.Authorization" value="read-only"/>
      <arg name="country_code" direction="in" type="s"/>
      <arg name="group_kind" direction="in" type="s"/>
      <arg name="group_name" direction="in" type="s"/>
      <arg name="servers_json" direction="out" type="s"/>
    </method>
