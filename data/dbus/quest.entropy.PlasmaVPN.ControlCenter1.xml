  "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "https://dbus.freedesktop.org/doc/dbus-specification.html">
<node name="/quest/entropy/PlasmaVPN/ControlCenter">
  <interface name="quest.entropy.PlasmaVPN.ControlCenter1">
    <annotation name="quest.entropy.PlasmaVPN.BusName"
                value="quest.entropy.PlasmaVPN.ControlCenter"/>
    <method name="Quit"/>
    <method name="RequestRunnerAction">
      <arg name="action" direction="in" type="s"/>
