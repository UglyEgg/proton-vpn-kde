[Unit]
Description=Backend adapter for the Plasma VPN community client

[Service]
Type=dbus
BusName=quest.entropy.PlasmaVPN.Backend
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/proton-vpn-kde-backend
Restart=on-failure
RestartSec=2s
TimeoutStopSec=35s
NoNewPrivileges=true
# PrivateTmp and ProtectSystem create a mount namespace that prevents this
# unprivileged service from authenticating peer executables through procfs on
# Fedora/SELinux. The backend already runs as the desktop user and cannot write
# root-owned system paths; preserving peer authentication is the stronger
# boundary.
UnsetEnvironment=@PROTON_VPN_KDE_UNSAFE_ENVIRONMENT_SYSTEMD@

[Install]
WantedBy=default.target
