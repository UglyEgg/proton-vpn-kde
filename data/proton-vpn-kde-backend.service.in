[Unit]
Description=Proton VPN backend for the native KDE Plasma client
Documentation=https://github.com/ProtonVPN/proton-vpn-gtk-app

[Service]
Type=dbus
BusName=proton.vpn.app.kde.backend
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/proton-vpn-kde-backend
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=default.target
