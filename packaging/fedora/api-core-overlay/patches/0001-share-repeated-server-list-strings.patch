+_SHARED_SERVER_STRING_FIELDS = frozenset({
+    "EntryCountry", "ExitCountry", "HostCountry", "City", "State", "Domain",
+    "EntryIP", "ExitIP", "Generation", "Label", "ServicesDownReason",
+    "X25519PublicKey",
+})
