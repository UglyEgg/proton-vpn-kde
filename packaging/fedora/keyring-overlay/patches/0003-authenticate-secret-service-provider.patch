 logger = logging.getLogger(__name__)
 
 
+_DBUS_NAME = "org.freedesktop.DBus"
+_DBUS_PATH = "/org/freedesktop/DBus"
+_SECRET_SERVICE_NAME = "org.freedesktop.secrets"
+_MAX_PROC_VALUE_BYTES = 1024 * 1024
+_UNSAFE_PROVIDER_ENVIRONMENT = {
+    "LD_AUDIT",
+    "LD_LIBRARY_PATH",
+    "LD_PRELOAD",
+    "GI_TYPELIB_PATH",
+    "GIO_EXTRA_MODULES",
+    "GTK_PATH",
+    "PYTHONHOME",
+    "PYTHONPATH",
+    "QML2_IMPORT_PATH",
+    "QML_IMPORT_PATH",
+    "QT_PLUGIN_PATH",
+    "QT_QPA_PLATFORM_PLUGIN_PATH",
+}
+_GENERIC_PROVIDER_LAUNCHERS = {
+    "bwrap",
+    "env",
+    "flatpak",
+    "java",
+    "node",
+    "nodejs",
+    "perl",
+    "python",
+    "python3",
+    "pwsh",
+    "ruby",
+    "sh",
+    "snap",
+}
