+
+def _is_generic_provider_launcher(executable_name):
+    if executable_name in _GENERIC_PROVIDER_LAUNCHERS:
+        return True
+    return bool(
+        re.fullmatch(
+            r"(?:ba|c|da|fi|k|tc|z)?sh"
+            r"|python(?:\d+(?:\.\d+)*)?"
+            r"|pypy\d*",
+            executable_name,
+        )
+    )
+
+
+def _dbus_call(connection, method, signature, *body):
+    address = DBusAddress(_DBUS_PATH, _DBUS_NAME, _DBUS_NAME)
+    reply = connection.send_and_get_reply(
+        new_method_call(address, method, signature, body)
+    )
+    if reply.header.message_type == MessageType.error:
+        raise DBusErrorResponse(reply)
+    return reply.body
+
+
+def _read_proc_value(pid, name):
+    with open(f"/proc/{pid}/{name}", "rb") as proc_file:
+        value = proc_file.read(_MAX_PROC_VALUE_BYTES + 1)
+    if len(value) > _MAX_PROC_VALUE_BYTES:
+        raise keyring.errors.InitError(
+            "Secret Service provider process metadata is too large"
+        )
+    return value
+
+
+def _verify_provider_process(pid, provider_uid):
+    if provider_uid != os.getuid():
+        raise keyring.errors.InitError(
+            "Secret Service provider belongs to an unexpected user"
+        )
+
+    executable = os.path.realpath(f"/proc/{pid}/exe")
+    executable_stat = os.stat(executable)
+    if (
+        not stat.S_ISREG(executable_stat.st_mode)
+        or executable_stat.st_uid != 0
+        or executable_stat.st_mode & 0o022
+        or not executable_stat.st_mode & 0o111
+    ):
+        raise keyring.errors.InitError(
+            "Secret Service provider executable is not trusted"
+        )
+    executable_name = os.path.basename(executable).lower()
+    if _is_generic_provider_launcher(executable_name):
+        raise keyring.errors.InitError(
+            "Secret Service provider uses an untrusted generic launcher"
+        )
+
+    environment = _read_proc_value(pid, "environ").split(b"\0")
+    environment_names = {
+        entry.partition(b"=")[0].decode("ascii", "ignore")
+        for entry in environment
+        if b"=" in entry
+    }
+    if environment_names & _UNSAFE_PROVIDER_ENVIRONMENT:
+        raise keyring.errors.InitError(
+            "Secret Service provider uses an unsafe process environment"
+        )
+
+
+def _authenticate_secret_service_provider(connection):
+    # Activate a configured provider without sending it any secret data, then
+    # authenticate the unique owner independently of the well-known address.
+    _dbus_call(connection, "StartServiceByName", "su", _SECRET_SERVICE_NAME, 0)
+    owner, = _dbus_call(
+        connection, "GetNameOwner", "s", _SECRET_SERVICE_NAME
+    )
+    pid, = _dbus_call(connection, "GetConnectionUnixProcessID", "s", owner)
+    provider_uid, = _dbus_call(
+        connection, "GetConnectionUnixUser", "s", owner
+    )
+    _verify_provider_process(pid, provider_uid)
+
+    # Close the process-reuse and exec/owner-change race before returning the
+    # identity that every Secret Service call will use as its destination.
+    current_owner, = _dbus_call(
+        connection, "GetNameOwner", "s", _SECRET_SERVICE_NAME
+    )
+    current_pid, = _dbus_call(
+        connection, "GetConnectionUnixProcessID", "s", owner
+    )
+    if current_owner != owner or current_pid != pid:
+        raise keyring.errors.InitError(
+            "Secret Service provider changed during authentication"
+        )
+    return owner
+
+
+class _PinnedSecretServiceConnection:
+    """Route Secret Service traffic only to one authenticated unique owner."""
+
+    def __init__(self, connection, owner):
+        self._connection = connection
+        self._owner = owner
+
+    def assert_current_owner(self):
+        try:
+            current_owner, = _dbus_call(
+                self._connection,
+                "GetNameOwner",
+                "s",
+                _SECRET_SERVICE_NAME,
+            )
+        except DBusErrorResponse as exc:
+            raise keyring.errors.InitError(
+                "Secret Service provider is unavailable"
+            ) from exc
+        if current_owner != self._owner:
+            raise keyring.errors.InitError(
+                "Secret Service provider identity changed"
+            )
+
+    def send_and_get_reply(self, message, **kwargs):
+        secret_service_call = (
+            message.header.fields.get(HeaderFields.destination)
+            == _SECRET_SERVICE_NAME
+        )
+        if secret_service_call:
+            self.assert_current_owner()
+            message.header.fields[HeaderFields.destination] = self._owner
+        reply = self._connection.send_and_get_reply(message, **kwargs)
+        if (
+            secret_service_call
+            and reply.header.message_type != MessageType.error
+            and reply.header.fields.get(HeaderFields.sender) != self._owner
+        ):
+            raise keyring.errors.InitError(
+                "Secret Service reply came from an unexpected provider"
+            )
+        return reply
+
+    def recv_until_filtered(self, *args, **kwargs):
+        message = self._connection.recv_until_filtered(*args, **kwargs)
+        if message.header.fields.get(HeaderFields.sender) != self._owner:
+            raise keyring.errors.InitError(
+                "Secret Service signal came from an unexpected provider"
+            )
+        return message
+
+    def close(self):
+        self._connection.close()
+
+    def __getattr__(self, name):
+        return getattr(self._connection, name)
+
