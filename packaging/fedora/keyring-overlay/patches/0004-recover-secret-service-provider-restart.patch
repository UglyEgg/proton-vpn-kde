+@pytest.mark.parametrize(
+    "restart_error",
+    [
+        "Secret Service provider is unavailable",
+        "Secret Service provider identity changed",
+    ],
+)
+def test_secret_read_rebinds_once_after_provider_restart(restart_error):
+    backend = secretservice_backend._get_secret_service_backend()
+    stale_connection = mock.Mock()
+    stale_finalizer = mock.Mock(alive=True)
+    backend._connection = stale_connection
+    backend._connection_finalizer = stale_finalizer
+    item = mock.Mock()
+    item.is_locked.return_value = False
+    item.get_secret.return_value = b"secret"
+    replacement_collection = mock.Mock()
+    replacement_collection.search_items.return_value = [item]
+    backend.get_preferred_collection = mock.Mock(
+        side_effect=[
+            keyring.errors.InitError(restart_error),
+            replacement_collection,
+        ]
+    )
+
+    assert backend.get_password("service", "username") == "secret"
+
+    stale_finalizer.assert_called_once_with()
+    assert backend._connection is None
+    assert backend.get_preferred_collection.call_count == 2
+
+
+def test_secret_read_does_not_retry_unrelated_initialization_error():
+    backend = secretservice_backend._get_secret_service_backend()
+    backend.get_preferred_collection = mock.Mock(
+        side_effect=keyring.errors.InitError(
+            "default collection is ambiguous"
+        )
+    )
+
+    with pytest.raises(keyring.errors.InitError, match="ambiguous"):
+        backend.get_password("service", "username")
+
+    backend.get_preferred_collection.assert_called_once_with()
+
+
