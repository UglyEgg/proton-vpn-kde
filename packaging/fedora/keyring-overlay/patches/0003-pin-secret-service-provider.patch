+_DBUS_NAME = "org.freedesktop.DBus"
+_DBUS_PATH = "/org/freedesktop/DBus"
+_DBUS_SERVICE_UNKNOWN = "org.freedesktop.DBus.Error.ServiceUnknown"
+_SECRET_SERVICE_NAME = "org.freedesktop.secrets"
+
+
+def _dbus_call(connection, method, signature, *body):
+    address = DBusAddress(_DBUS_PATH, _DBUS_NAME, _DBUS_NAME)
+    reply = connection.send_and_get_reply(
+        new_method_call(address, method, signature, body)
+    )
+    if reply.header.message_type == MessageType.error:
+        raise DBusErrorResponse(reply)
+    return reply.body
+
+
+def _pin_secret_service_provider(connection):
+    # Activate a configured provider without sending it any secret data, then
+    # resolve the unique owner independently of the well-known address.
+    try:
+        _dbus_call(
+            connection,
+            "StartServiceByName",
+            "su",
+            _SECRET_SERVICE_NAME,
+            0,
+        )
+    except DBusErrorResponse as exc:
+        # Desktop-autostarted providers such as KeePassXC can already own the
+        # name without installing a D-Bus activation service. GetNameOwner
+        # below still fails closed when no provider is actually running.
+        if exc.name != _DBUS_SERVICE_UNKNOWN:
+            raise
+    owner, = _dbus_call(
+        connection, "GetNameOwner", "s", _SECRET_SERVICE_NAME
+    )
+    provider_uid, = _dbus_call(
+        connection, "GetConnectionUnixUser", "s", owner
+    )
+    if provider_uid != os.getuid():
+        raise keyring.errors.InitError(
+            "Secret Service provider belongs to an unexpected user"
+        )
+
+    # Close the owner-change race before returning the identity that every
+    # Secret Service call will use as its destination.
+    current_owner, = _dbus_call(
+        connection, "GetNameOwner", "s", _SECRET_SERVICE_NAME
+    )
+    if current_owner != owner:
+        raise keyring.errors.InitError(
+            "Secret Service provider changed during selection"
+        )
+    return owner
+
+
+class _PinnedSecretServiceConnection:
+    """Route Secret Service traffic only to one selected unique owner."""
+
+    def __init__(self, connection, owner):
+        self._connection = connection
+        self._owner = owner
+
+    def assert_current_owner(self):
+        try:
+            current_owner, = _dbus_call(
+                self._connection,
+                "GetNameOwner",
+                "s",
+                _SECRET_SERVICE_NAME,
+            )
+        except DBusErrorResponse as exc:
+            raise keyring.errors.InitError(
+                "Secret Service provider is unavailable"
+            ) from exc
+        if current_owner != self._owner:
+            raise keyring.errors.InitError(
+                "Secret Service provider identity changed"
+            )
+
+    def send_and_get_reply(self, message, **kwargs):
+        secret_service_call = (
+            message.header.fields.get(HeaderFields.destination)
+            == _SECRET_SERVICE_NAME
+        )
+        if secret_service_call:
+            self.assert_current_owner()
+            message.header.fields[HeaderFields.destination] = self._owner
+        reply = self._connection.send_and_get_reply(message, **kwargs)
+        if (
+            secret_service_call
+            and reply.header.message_type != MessageType.error
+            and reply.header.fields.get(HeaderFields.sender) != self._owner
+        ):
+            raise keyring.errors.InitError(
+                "Secret Service reply came from an unexpected provider"
+            )
+        return reply
+
+    def recv_until_filtered(self, *args, **kwargs):
+        message = self._connection.recv_until_filtered(*args, **kwargs)
+        if message.header.fields.get(HeaderFields.sender) != self._owner:
+            raise keyring.errors.InitError(
+                "Secret Service signal came from an unexpected provider"
+            )
+        return message
+
+    def close(self):
+        self._connection.close()
+
+    def __getattr__(self, name):
+        return getattr(self._connection, name)
+
