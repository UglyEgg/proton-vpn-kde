#!/bin/sh
# SPDX-FileCopyrightText: 2022-2026 Proton AG
# SPDX-FileCopyrightText: 2026 Plasma VPN contributors
# SPDX-License-Identifier: GPL-3.0-or-later

set -e
case "$1" in
    remove|purge)
        if ! ks_error=$(busctl call \
                me.proton.vpn.kill_switch /me/proton/vpn/kill_switch \
                me.proton.vpn.kill_switch Disable 2>&1); then
            echo "warning: could not disable the Proton VPN kill switch: ${ks_error}" >&2
        fi
        # Proton stores permanent-mode enablement in this unowned symlink.
        # Preserve its removal contract even if the running service is absent.
        systemctl disable proton-vpn-kill-switch-boot.service >/dev/null 2>&1 || true
        ;;
esac

if command -v py3clean >/dev/null 2>&1; then
    py3clean -p python3-proton-vpn-api-core:amd64
else
    dpkg -L python3-proton-vpn-api-core:amd64 \
        | sed -En -e '/^(.*)\/(.+)\.py$/s,,rm "\1/__pycache__/\2".*,e'
    find /usr/lib/python3/dist-packages/ -type d -name __pycache__ -empty -print0 \
        | xargs --null --no-run-if-empty rmdir
fi

#DEBHELPER#

exit 0
