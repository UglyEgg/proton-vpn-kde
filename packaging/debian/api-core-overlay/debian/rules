#!/usr/bin/make -f
# SPDX-FileCopyrightText: 2026 Plasma VPN contributors
# SPDX-License-Identifier: GPL-3.0-or-later

export PYBUILD_NAME = protonvpn_api_core
export PYTHONDONTWRITEBYTECODE = 1

%:
	dh $@ --with python3

override_dh_auto_configure:
	python3 rebuild_overlay.py prepare \
		--manifest overlay-manifest.json \
		--vendor-deb python3-proton-vpn-api-core_5.6.10_amd64.deb \
		--source-directory . \
		--baseline-root vendor-rootfs \
		--overlay-root overlay-rootfs

override_dh_auto_build:

override_dh_auto_test:
	python3 rebuild_overlay.py verify-tree \
		--manifest overlay-manifest.json \
		--baseline-root vendor-rootfs \
		--overlay-root overlay-rootfs
	python3 api-core-overlay-verifier.py verify-behavior \
		--root overlay-rootfs \
		--site-packages usr/lib/python3/dist-packages
	python3 rebuild_overlay.py verify-tree \
		--manifest overlay-manifest.json \
		--baseline-root vendor-rootfs \
		--overlay-root overlay-rootfs

override_dh_auto_install:
	install -d debian/python3-proton-vpn-api-core
	cp -a overlay-rootfs/. debian/python3-proton-vpn-api-core/

# The payload already carries Proton's generated Python metadata. Rewriting it
# would exceed the manifest's six-file source boundary.
override_dh_python3:

# Preserve Proton's prebuilt Rust/Python ABI payload byte-for-byte.
override_dh_strip:

override_dh_dwz:
